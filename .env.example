# ==============================================================================
# SysGalaxy Payment Verification Gateway — Environment Configuration Example
# ==============================================================================

# Server Environment & Port
NODE_ENV=production
PORT=4000
HOST=0.0.0.0
API_BASE_URL=https://api.payments.yourdomain.com

# Database Configuration
# Leave empty for embedded PGlite, or provide standard PostgreSQL connection string for Production:
# DATABASE_URL=postgresql://sysgalaxy_user:secure_password@host:5432/sysgalaxy_db
DATABASE_URL=
PGLITE_DATA_DIR=./data/pglite

# Receipt Screenshot Storage
STORAGE_ADAPTER=local
STORAGE_LOCAL_DIR=./storage/uploads
STORAGE_MAX_FILE_SIZE_BYTES=10485760

# Local OCR Engine
OCR_ENGINE=tesseract
OCR_CONFIDENCE_THRESHOLD=60.0

# Security & Master Admin Key
MASTER_ADMIN_KEY=sg_live_master_admin_production_secret_key

# CORS Whitelist
CORS_ORIGIN=https://dashboard.payments.yourdomain.com

# ==============================================================================
# Automated Gmail Bank Alerts Ingestion (IMAP 993 SSL)
# ==============================================================================
GMAIL_ENABLED=true
GMAIL_USER=your_bank_alert_email@gmail.com
# Paste your 16-character Google App Password (generated from myaccount.google.com/apppasswords):
GMAIL_APP_PASSWORD=your_16_digit_app_password
GMAIL_POLL_INTERVAL_MS=30000

# ==============================================================================
# Google Cloud Pub/Sub Push Webhook (Real-Time Gmail Push Notifications)
# ==============================================================================
# Optional secret token to verify Pub/Sub push requests:
# e.g. https://your-domain.com/v1/bank-feeds/gmail/pubsub-webhook?token=your_secret_token
GMAIL_PUBSUB_SECRET=

# ==============================================================================
# Dashboard Admin Credentials (Production Authentication)
# ==============================================================================
GATEWAY_ADMIN_USER=admin
GATEWAY_ADMIN_PASSWORD=your_secure_dashboard_password_here
GATEWAY_JWT_SECRET=your_production_jwt_secret_key_here


